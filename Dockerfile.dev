FROM node:20-alpine

ARG FOLDER=/app

COPY . /app

WORKDIR ${FOLDER}

RUN apk add --update --no-cache python3 tini && \
    chmod +x $FOLDER/restart-n8n.sh

RUN chown -R 1000:1000 ${FOLDER}

ENV N8N_USER_FOLDER=${FOLDER}/n8n-server

ENV N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

ENV N8N_RUNNERS_ENABLED=true

EXPOSE 5678

USER 1000:1000

ENTRYPOINT ["tini", "--"]

CMD ["sh", "-c", "exec npx nodemon --signal SIGTERM --watch ./nodes/ --watch ./credentials/ --ext ts,js,json --exec 'sh ./restart-n8n.sh'"]